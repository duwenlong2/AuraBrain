# AuraBrain 依赖 / 源码忽略规则

# Mastra 框架源码（独立拉取，见 README「如何获取 Mastra 源码」）
/mastra/

# Node
node_modules/
dist/
.mastra/
**/bin/
**/obj/

# Environment files used by learning examples; never commit local secrets.
.env
.env.*
!.env.example

.aurabrain-runtime.pid
.aurabrain/
# Local mail, Outlook, and capability policy experiments.
/capabilities.json
/*.reg
/scripts/set-outlook-address-info-policy.ps1
/src/main/lib/capability-manifest.ts
/src/main/lib/mail-review-store.ts
/src/main/lib/outlook-imap-oauth.ts
/src/main/lib/outlook-policy.ts
/src/main/lib/task-debug.ts
/src/main/public/task-debug.html
/src/main/public/task-review.html
# Workspace frontend is synchronized here only for local packaging.
/src/main/public/workspace/

# 数据库 / 本地存储
*.db
*.db-*
*.duckdb
*.duckdb.wal

# 日志
*.log
npm-debug.log*

# 操作系统
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
